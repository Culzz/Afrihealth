{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/web && npm ci --no-audit --no-fund && npm run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "echo \"(deps installed per-build command)\"",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index.py" },
    { "source": "/api/health", "destination": "/api/index.py" }
  ]
}
